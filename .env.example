# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Google Sheet lead capture. Both must be set or /api/lead reports
# "lead_sink_not_configured" and no leads are stored (the booking flow still works).
#
# Full setup walkthrough: docs/GOOGLE_SHEET_LEAD_CAPTURE.md

# The Apps Script Web App URL — Deploy → New deployment → Web app.
LEADS_WEBHOOK_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Must match the SHARED_SECRET script property in the Apps Script project.
# Generate with: openssl rand -hex 32
LEADS_WEBHOOK_SECRET=""
